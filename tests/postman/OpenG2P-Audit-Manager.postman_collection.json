{
  "info": {
    "name": "OpenG2P Audit Manager",
    "_postman_id": "1d5d9cde-7a8b-4e14-9b2c-0aa4f6e2b101",
    "description": "Smoke-test collection for the OpenG2P Audit Manager service. Covers the full CloudEvents ingest API plus representative event shapes: login success/failure, beneficiary view/update, payment approve/reverse (system-initiated), access-denied, and a batched submission. All POSTs should return 202 Accepted immediately; events land in Postgres via Kafka within a few seconds.\n\nDefault base URL points at `docker compose up` on localhost. Override the `baseUrl` collection variable for any other environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "description": "Base URL of the Audit Manager. Override per-environment."
    },
    {
      "key": "apiPrefix",
      "value": "/v1/auditmanager",
      "description": "OpenG2P service prefix — do not change."
    }
  ],
  "item": [
    {
      "name": "Service endpoints",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/health",
              "host": ["{{baseUrl}}{{apiPrefix}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status = UP', () => pm.expect(pm.response.json().response.status).to.eql('UP'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /version",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/version",
              "host": ["{{baseUrl}}{{apiPrefix}}"],
              "path": ["version"]
            }
          }
        },
        {
          "name": "GET /config",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/config",
              "host": ["{{baseUrl}}{{apiPrefix}}"],
              "path": ["config"]
            }
          }
        },
        {
          "name": "GET /docs (Swagger UI)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/docs",
              "host": ["{{baseUrl}}"],
              "path": ["docs"]
            }
          }
        }
      ]
    },
    {
      "name": "Single events — success",
      "item": [
        {
          "name": "POST /events — auth.login (success)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "content-type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/events",
              "host": ["{{baseUrl}}{{apiPrefix}}"],
              "path": ["events"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"specversion\": \"1.0\",\n  \"id\": \"pm-01-login-success\",\n  \"source\": \"/openg2p/auth\",\n  \"type\": \"org.openg2p.auth.login\",\n  \"time\": \"2026-04-22T14:03:21Z\",\n  \"data\": {\n    \"actor\":   { \"type\": \"user\", \"id\": \"u_4421\", \"name\": \"fatima.k\" },\n    \"action\":  \"login\",\n    \"outcome\": \"success\",\n    \"context\": { \"ip\": \"10.2.14.88\", \"mfa\": \"totp\" }\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "pm.test('id echoed', () => pm.expect(pm.response.json().response.accepted).to.eql('pm-01-login-success'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /events — beneficiary.viewed (with trace)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "content-type", "value": "application/json" }

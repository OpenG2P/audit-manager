    {
      "name": "Batch",
      "item": [
        {
          "name": "POST /events/batch — 3 events",
          "request": {
            "method": "POST",
            "header": [
              { "key": "content-type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/events/batch",
              "host": ["{{baseUrl}}{{apiPrefix}}"],
              "path": ["events", "batch"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"specversion\": \"1.0\",\n      \"id\": \"pm-08-batch-a\",\n      \"source\": \"/openg2p/auth\",\n      \"type\": \"org.openg2p.auth.logout\",\n      \"time\": \"2026-04-22T18:00:00Z\",\n      \"data\": {\n        \"actor\":   { \"type\": \"user\", \"id\": \"u_4421\" },\n        \"action\":  \"logout\",\n        \"outcome\": \"success\"\n      }\n    },\n    {\n      \"specversion\": \"1.0\",\n      \"id\": \"pm-08-batch-b\",\n      \"source\": \"/openg2p/program-service\",\n      \"type\": \"org.openg2p.program.enrolled\",\n      \"subject\": \"beneficiary/b_1029384756\",\n      \"time\": \"2026-04-22T14:15:00Z\",\n      \"data\": {\n        \"actor\":    { \"type\": \"user\", \"id\": \"u_4421\" },\n        \"action\":   \"enroll\",\n        \"outcome\":  \"success\",\n        \"resource\": { \"type\": \"beneficiary\", \"id\": \"b_1029384756\", \"program_id\": \"pmt_2025_q2\" }\n      }\n    },\n    {\n      \"specversion\": \"1.0\",\n      \"id\": \"pm-08-batch-c\",\n      \"source\": \"/openg2p/config-service\",\n      \"type\": \"org.openg2p.config.changed\",\n      \"time\": \"2026-04-22T19:30:00Z\",\n      \"data\": {\n        \"actor\":    { \"type\": \"user\", \"id\": \"u_admin\", \"roles\": [\"admin\"] },\n        \"action\":   \"update\",\n        \"outcome\":  \"success\",\n        \"resource\": { \"type\": \"config\", \"id\": \"payment.limit.default\" },\n        \"changes\":  [{ \"field\": \"max_amount\", \"from\": \"5000\", \"to\": \"10000\" }]\n      }\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "pm.test('all 3 accepted', () => pm.expect(pm.response.json().response.count).to.eql(3));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
